# ============================================================
# 复制为 .env 并填入你自己的密钥；.env 已被 .gitignore 排除
# 任何 OpenAI 兼容接口都可以用（DeepSeek / 通义千问 / 本地 vLLM ...）
# ============================================================

# 必填：LLM 的 API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 接口地址
# DeepSeek:       https://api.deepseek.com/v1
# 通义千问兼容:    https://dashscope.aliyuncs.com/compatible-mode/v1
# 本地 Ollama:     http://localhost:11434/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名
# DeepSeek: deepseek-chat
# 千问:     qwen-max
LLM_MODEL=deepseek-chat

# 可选：任务画像（换任务时改这个文件，不用改代码）
# TASK_PROFILE=config/task_profile.yaml
